<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AromaDom.MainWindow" Title="Арома Дом — материалы" Width="1000" Height="740" MinWidth="760" MinHeight="520">
    

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Арома Дом" FontSize="30" Foreground="#8A5A44"/>
            <TextBlock Text="Материалы для производства свечей" Margin="0,8,0,12"/>
            <WrapPanel>
                <Button Content="Добавить материал" Click="AddClick"/>
                <Button Content="Калькулятор выпуска" Click="CalculatorClick"/>
                <Button Content="Импорт таблиц Excel" Click="ImportClick"/>
            </WrapPanel>
            <TextBlock x:Name="Summary" Margin="4,12"/>
        </StackPanel>
        

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MaterialsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F4E6D4" Padding="16" Margin="0,0,0,12" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Heading}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding MinimumText}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding StockText}" Margin="0,4"/>
                                    <TextBlock Text="{Binding PriceText}"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="Редактировать" Click="EditClick" Tag="{Binding Id}"/>
                                        <Button Content="Продукция" Click="ProductsClick" Tag="{Binding Id}"/>
                                    </WrapPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding RequiredText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
